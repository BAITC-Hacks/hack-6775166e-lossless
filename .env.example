# Preferred model-based selection of verified explanation facts.
# Copy this file to .env in the repository root. Model settings load automatically.
# Process environment variables override .env, including empty values.
NVIDIA_API_KEY=
NVIDIA_MODEL=
# Optional fallback provider when NVIDIA is not configured.
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional local HTTP port (default: 8000); set in the shell:
# PORT=8000 python3 src/server.py
