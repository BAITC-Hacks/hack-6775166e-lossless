# Model-based selection of verified explanation facts.
# If .env does not exist, create it from this template in the repository root.
# Preserve any existing local .env; never commit API keys.
# These four settings load automatically from this checkout's .env.
# Process environment variables override .env, including empty values.

# NVIDIA has priority when both providers have complete settings.
# Optional dependency: python3 -m pip install -r requirements-model.txt
NVIDIA_API_KEY=
NVIDIA_MODEL=

# OpenAI Responses API uses the Python standard library.
# Default verified by the team release branch: gpt-4o-mini.
# Earlier integrated candidate also verified gpt-5.6-sol.
# Set OPENAI_MODEL to an exact model ID available to your account.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# To explicitly use OpenAI in the app even when NVIDIA is configured:
# NVIDIA_API_KEY= NVIDIA_MODEL= python3 src/server.py
# Check settings without an API request:
# python3 scripts/check-model.py --provider openai --check-config

# Optional local HTTP port (default: 8000); set in the shell, not in .env:
# PORT=8000 python3 src/server.py
